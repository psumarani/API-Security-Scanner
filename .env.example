# Copy to .env and replace placeholder values. Never commit .env.
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]

# PostgreSQL (Docker Compose publishes it on localhost:5433).
# The backend builds its connection URL from these; or set DATABASE_URL to override.
POSTGRES_USER=apisec
POSTGRES_PASSWORD=change-me
POSTGRES_DB=apisec
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Application-user authentication. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-generated-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Encrypts target-API credentials at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes stored credentials unrecoverable.
ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Scanner safety. Leave false unless you scan a deliberately vulnerable app on localhost
# (the bundled lab or crAPI). Even when true, each target must also opt in to "local lab".
ALLOW_LOCAL_LAB_TARGETS=false
# Scans that may run at the same time (others wait in "queued").
MAX_CONCURRENT_SCANS=2
